{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-desk/main/apps/desktop/tauri/schema.json",
  "identifier": "default",
  "description": "Aura 桌面客户端默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "opener:default"
  ]
}
