{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-desk/main/apps/desktop/tauri/schema.json",
  "productName": "Aura",
  "version": "0.1.0",
  "identifier": "com.aura.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8086",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "title": "Aura 智能体工作台",
    "windows": [
      {
        "title": "Aura 智能体工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
