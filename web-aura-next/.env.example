# ============================================================
# Aura 智能体平台 — 环境变量模板
# ============================================================
# 使用方式：
#   cp .env.example .env.local
#   然后编辑 .env.local 填入实际值
# ============================================================

# ====== 运行模式 ======
# server = 服务端模式（完整功能）
# client = 客户端模式（通过 X-Aura-Local-Key 免登接入）
AURA_MODE=server

# ====== 数据库 ======
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aura

# ====== 数据存储 ======
# 工作空间、上传文件等数据根目录
# Windows: D:\data\aura
# Linux:   /data/aura
DATA_ROOT=D:\data\aura

# ====== AI 模型 ======
# DeepSeek API（必填，服务端模式使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ====== 安全密钥（必填，服务端模式使用） ======
# JWT 签名密钥（任意随机字符串，越长越好）
AURA_JWT_SECRET=
# AES-256-GCM 加密密钥（64 位十六进制，用于加密存储 API Key 和数据库密码）
AURA_ENCRYPTION_KEY=

# ====== 联网搜索（可选） ======
# Bing Search API v7，不配则 web_search 工具不可用
BING_SEARCH_API_KEY=
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ====== 配额控制（可选，均有默认值） ======
# 每日 Token 配额上限（单工作空间），默认 500,000
# AURA_DAILY_TOKEN_LIMIT=500000
# 单次对话最大工具调用步数，默认 20
# AURA_MAX_STEPS_HARD=20

# ====== 客户端模式专用 ======
# 客户端模式下的服务端 API 地址
# AURA_SERVER_URL=http://localhost:8086
